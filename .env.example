# Copy to .env and fill in. NEVER commit .env — this repo signs transactions.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Base RPC — the fork venue (F1 §1)
# ---------------------------------------------------------------------------
# Used to fork Base at the pinned block in config/addresses.8453.json.
# Optional: the fork tests fall back to the public endpoint below when unset,
# so `forge test` works with no setup. Set it to a provider URL for real work —
# the public endpoint rate-limits and will not survive the taker driver.
#
# HEADS UP: Foundry loads .env from ITS OWN project root, which is contracts/,
# NOT the repo root. So for `forge test` either export this in your shell:
#
#   export SLUICE_RPC_URL=https://...
#
# or drop a copy in contracts/.env (gitignored at every level).
SLUICE_RPC_URL=https://mainnet.base.org
