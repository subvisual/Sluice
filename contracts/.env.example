# Foundry loads .env from ITS OWN project root — this directory — not the repo root.
# That is why this file lives here rather than beside the top-level CLAUDE.md.
#
#   cd contracts && cp .env.example .env
#
# .env is gitignored at every level. Never commit one.

# ---------------------------------------------------------------------------
# Base RPC — the fork venue (F1 §1)
# ---------------------------------------------------------------------------
# Used to fork Base at the pinned block in ../config/addresses.8453.json.
#
# Optional: the fork tests fall back to Base's public endpoint when this is
# unset, so `forge test` works on a fresh clone with no setup. Point it at a
# real provider for anything heavier — the public endpoint rate-limits and will
# not survive the taker driver.
SLUICE_RPC_URL=https://mainnet.base.org
