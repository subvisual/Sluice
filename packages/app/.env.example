# The local-fork read RPC: an anvil fork of Base at the pinned block. The
# header dropdown switches the read path between this and
# NEXT_PUBLIC_BASE_RPC_URL — chainId reads 8453 either way, so the URLs are
# the only thing that tells a rehearsal from the real thing here.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional mainnet read RPC override (default https://mainnet.base.org):
# NEXT_PUBLIC_BASE_RPC_URL=

# Reown Cloud projectId (dashboard.reown.com) — public by nature, required
# for the wallet connect modal; absent => the header shows a note instead.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Server-only (never NEXT_PUBLIC_) — the /api/compose enclave path. ---
# Funded 0G Galileo testnet key (faucet.0g.ai). Absent => the route still
# answers, labelled TEMPLATE_FALLBACK with the reason. The compute ledger is
# prepaid escrow, funded once, out-of-band:
#   cd ../arbitration-sdk && npm run fund
ZG_PRIVATE_KEY=
# Optional overrides (defaults in packages/arbitration-sdk/src/config.ts):
# ZG_RPC=https://evmrpc-testnet.0g.ai
# ZG_PROVIDER=0xa48f01287233509FD694a22Bf840225062E67836
# ZG_MODEL=qwen/qwen2.5-omni-7b
# Book subgraph override (defaults to the deployed Base Studio subgraph):
# SLUICE_SUBGRAPH_URL=
